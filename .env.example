# Template for .env.<env> — copy, then fill in the real values.
#
# The real .env.<env> files are GITIGNORED: they carry the registry host, the image tag,
# ports, storage paths and credentials. This template is COMMITTED so a clean clone knows
# what to set (repo.compose_conventions / FLEET-BUILD-DEPLOY-STANDARD).
#
# Placeholders only in this file. It is tracked and published, and luxlint scans it for
# both the credential and the disclosure tier — a real host or key here is a leak.
#
# NOT to be confused with the bare `.env`, which is unrelated: the Makefile includes it for
# registry credentials (GHCR_TOKEN). Compose never reads it.

# ── Stack identity (what compose.yml interpolates) ───────────────────────────────────
# There is ONE compose.yml. An environment is THIS file, named on the command line:
#   docker compose --env-file .env.<env> up -d
# so every per-site and per-env difference is a value here, never an overlay file.
#
# STACK_NAME is both the compose project name and the container name, so two site stacks
# on one host stay disjoint.
STACK_NAME=luxupt-<site>
# The path to THIS file. compose.yml passes it to the container as env_file, which is a
# different mechanism from --env-file (that one only feeds interpolation).
ENV_FILE=.env.<site>
WEB_PORT=11000
# Host headers the app answers (comma list, no ports). REQUIRED: unset, empty or `*` refuses to
# start. localhost is not needed for the container health check, and listing it lets any client
# send `Host: localhost` to every route.
ALLOWED_HOSTS=<host.example.com>
# Host directory bind-mounted at /app/luxupt/output.
DATA_ROOT=../output-<site>
# `missing` pulls when absent. Every stack, dev included, runs a tag that was pushed.
PULL_POLICY=missing

# ── Image ────────────────────────────────────────────────────────────────────────────
# The stack RUNS a tag; it never builds. Publish with `make release` / `make dev-deploy`,
# then name the exact artifact here: a version or sha-<commit>, never :dev/:latest.
REGISTRY=registry.example.internal:5000
TAG=2026.09.0

# ── nginx (only read by `--profile nginx`) ───────────────────────────────────────────
# One nginx fronts every site stack on the host and terminates SSL; app containers are
# expose-only and never publish a host port.
CERT_ROOT=/path/to/certs
NGINX_PORT_PRIMARY=11000
NGINX_PORT_SECONDARY=11001

# ── Dev host (only .env.<site>-dev) ──────────────────────────────────────────────────
# A dev stack runs on the dev host (DEV_HOST in the Makefile) behind nginx-dev, which the bb dev
# stack starts (profile dev-edge) and which reaches each site's app on luxupt_front at port 8080.
# So a dev env file sets:
#   APP_NETWORK=luxupt_front
#   WEB_PORT=8080
#   ALLOWED_HOSTS=dev-luxupt-<site>.<domain>
#   CERT_ROOT=<the dev domain's certificate directory on the dev host>
# Prod leaves APP_NETWORK unset (luxupt-network, behind the host's nginx).

# ── Runtime ──────────────────────────────────────────────────────────────────────────
TZ=UTC
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Storage (bind-mount roots on the node) ───────────────────────────────────────────
IMAGE_OUTPUT_PATH=/data/luxupt/images
VIDEO_OUTPUT_PATH=/data/luxupt/videos

# ── UniFi Protect ────────────────────────────────────────────────────────────────────
UNIFI_PROTECT_BASE_URL=https://<nvr-host>/proxy/protect/integration/v1
UNIFI_PROTECT_API_KEY=your-api-key-here
UNIFI_PROTECT_VERIFY_SSL=false
# Only needed for the historical/recording features (a local Protect user, not Ubiquiti SSO)
UNIFI_PROTECT_USERNAME=
UNIFI_PROTECT_PASSWORD=

# ── Web interface ────────────────────────────────────────────────────────────────────
# The first admin, applied ONCE while the users table is empty (must change it at first sign-in),
# then ignored. Left empty, startup prints a one-time token and /setup creates the admin instead.
# INITIAL_ADMIN_PASSWORD_FILE=/run/secrets/... takes a Docker secret in place of the password.
# Locked out later: run the reset-password command in the container (see the release notes).
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
WEB_SESSION_SECRET=changeme-generate-with-token_urlsafe-32

# ── Feature toggles ──────────────────────────────────────────────────────────────────
FETCH_ENABLED=false
TIMELAPSE_CREATION_ENABLED=false

# ── A DEV stack ──────────────────────────────────────────────────────────────────────
# Same file shape; only these differ. TAG is written by `make dev-deploy SITE=<site>` (publish
# this commit, pin it, restart) or `make dev-pin SITE=<site> TAG=sha-<commit>` (roll back) —
# never edited by hand, never a moving tag.
#
#   TAG=sha-<commit>
#   LOG_LEVEL=DEBUG
#   DATA_ROOT=./output-<site>     # project-local dev data, never prod's storage
#   FETCH_ENABLED=false           # capture off by default for web-only work
#   TIMELAPSE_CREATION_ENABLED=false
