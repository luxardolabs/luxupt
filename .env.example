# Template for .env.<env> — copy, then fill in the real values.
#
# The real .env.<env> files are GITIGNORED: they carry the registry host, the image tag,
# ports, storage paths and credentials. This template is COMMITTED so a clean clone knows
# what to set (repo.compose_conventions / FLEET-BUILD-DEPLOY-STANDARD).
#
# Placeholders only in this file. It is tracked and published, and luxlint scans it for
# both the credential and the disclosure tier — a real host or key here is a leak.

# ── Image ────────────────────────────────────────────────────────────────────────────
# The stack RUNS a tag; it never builds. Build with `make release` / `make build-dev`,
# then name the exact artifact here. Never :latest — a deployable does not roll.
REGISTRY=registry.example.internal:5000
TAG=2026.08.0

# ── Runtime ──────────────────────────────────────────────────────────────────────────
TZ=UTC
LOGGING_LEVEL=INFO
LOGGING_FORMAT=json

# ── Storage (bind-mount roots on the node) ───────────────────────────────────────────
IMAGE_OUTPUT_PATH=/data/luxupt/images
VIDEO_OUTPUT_PATH=/data/luxupt/videos

# ── UniFi Protect ────────────────────────────────────────────────────────────────────
UNIFI_PROTECT_BASE_URL=https://<nvr-host>/proxy/protect/integration/v1
UNIFI_PROTECT_API_KEY=your-api-key-here
UNIFI_PROTECT_VERIFY_SSL=false
# Only needed for the historical/recording features (a local Protect user, not Ubiquiti SSO)
UNIFI_PROTECT_USERNAME=
UNIFI_PROTECT_PASSWORD=

# ── Web interface ────────────────────────────────────────────────────────────────────
# Setting WEB_PASSWORD enables env-credential auth; leave blank to use database users.
WEB_USERNAME=admin
WEB_PASSWORD=changeme
WEB_SESSION_SECRET=changeme-generate-with-token_urlsafe-32

# ── Feature toggles ──────────────────────────────────────────────────────────────────
FETCH_ENABLED=false
TIMELAPSE_CREATION_ENABLED=false
