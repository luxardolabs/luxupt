# ── Secrets — NEVER commit. Only .env.example templates are allowed. ──
.env
.env.*
!.env.example

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
ENV/

# ── Tool caches ──
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── Node ──
node_modules/

# ── App runtime output ── (dev uses project-local ./output-<site>)
output/
output-*/
*.db
*.sqlite
*.sqlite3
*.log

# ── OS ──
.DS_Store
Thumbs.db

# ── Local-only: deploy infra & tooling not part of the public source subset ──
# NOTE: VERSION is committed (source of truth for clean-clone builds; repo.app_version_calver).
CLAUDE.md
# compose.yml IS committed: it is the one stack definition and carries no topology — every
# host/registry/tag/path in it is interpolated from a gitignored .env.<env>
# (repo.compose_conventions). Any OTHER compose file is a leftover overlay and stays ignored.
compose.*.yaml
compose.*.yml
docker-compose*.yml
nginx/
prod/
scratch/
package-lock.json
RELEASE.md
CHANGELOG.md
README.md.archived
.dockerignore

# Archived/scratch content (publish.py skips these)
**/_archive/
_archive/

# Private registry hosts (build config committed; only the host stays local)
Makefile.local

# ── Claude Code hooks (luxarch --emit hooks) ──
# The hook SOURCES and the wiring are committed so every clone runs the byte-identical set
# (repo.hooks_wired / hooks_current). The heartbeat is a runtime stamp proving they actually
# execute — machine-local, never committed. settings.local.json is per-developer.
.claude/.hooks-heartbeat
.claude/settings.local.json

# Claude Code hook session state (luxarch --emit hooks)
.claude/.luxpm-ledger.json
.claude/settings.json.bak
.claude/.push-hold
