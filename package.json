{
  "name": "luxupt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LuxUPT - Frontend Assets",
  "scripts": {
    "dev:css": "tailwindcss -i ./app/web/static/css/tailwind.css -o ./app/web/static/css/compiled.css --watch",
    "build:css": "NODE_ENV=production tailwindcss -i ./app/web/static/css/tailwind.css -o ./app/web/static/css/compiled.css --minify",
    "build": "npm run build:css",
    "lint:js": "eslint app/web/static/js/",
    "lint:js:fix": "eslint app/web/static/js/ --fix",
    "lint": "npm run lint:js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "tailwindcss": "^3.4.0"
  }
}
